{
  "background-tasks-monitor": {
    "PreToolUse": [
      {
        "matcher": "manage_subagents|manage_task|run_command|schedule",
        "hooks": [
          {
            "type": "command",
            "command": "node sidecars/tasks/main.mjs --hook PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node sidecars/tasks/main.mjs --hook PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node sidecars/tasks/main.mjs --hook Stop",
        "timeout": 10
      }
    ]
  }
}
